# Servidor
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Autenticación
ADMIN_PASSWORD=admin123
JWT_SECRET=tu-super-secret-key-cambiar-en-produccion
JWT_EXPIRES_IN=24h

# Base de Datos (Actual - JSON)
DB_TYPE=json
DB_PATH=./books.json

# Base de Datos (Futuro - MySQL/PostgreSQL)
# DATABASE_URL=mysql://user:password@localhost:3306/bibliosearch

# Cloudinary Configuration (IMAGE UPLOADS)
CLOUDINARY_CLOUD_NAME=tu_cloud_name_aqui
CLOUDINARY_API_KEY=tu_api_key_aqui
CLOUDINARY_API_SECRET=tu_api_secret_aqui

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Seguridad
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true
